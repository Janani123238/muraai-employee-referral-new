# --- Database ---
# SQLite (default, fine for demos/small deployments):
DATABASE_URL=sqlite:///./muraai.db
# Postgres example (recommended for production):
# DATABASE_URL=postgresql://muraai:muraai@db:5432/muraai

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Ollama local API (server-side only — never exposed to the browser) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- CORS ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# --- First admin account (recommended for production) ---
# If set, this HR/admin account is created automatically on first startup.
# Leave unset and the very first person to register on a fresh deployment
# will be offered the HR role instead (one-time only).
BOOTSTRAP_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-strong-password

ENV=production

# --- Password reset ---
# Public URL of the deployed frontend — the reset link emailed to users points here.
FRONTEND_URL=http://localhost:8000
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- Microsoft Graph email (send/read via client credentials) ---
# Email is sent EXCLUSIVELY through Microsoft Graph (no SMTP). Configured via
# the Azure App Registration (AZURE_CLIENT_ID / AZURE_CLIENT_SECRET /
# AZURE_TENANT_ID) plus GRAPH_SENDER_EMAIL. The App Registration must have the Graph
# application permissions Mail.Send and Mail.Read with Admin Consent granted.
# GRAPH_SENDER_EMAIL is the mailbox used as sender/reader, e.g. hr@yourcompany.com.
GRAPH_SENDER_EMAIL=

# --- Microsoft Entra ID SSO (MSAL, authorization-code flow) ---
# The Azure redirect URI is derived from FRONTEND_URL above, so register this
# EXACT URI in Entra (App registration -> Authentication -> Web):
#   http://localhost:8000/api/auth/microsoft/callback      (local)
#   https://<prod-domain>/api/auth/microsoft/callback      (production)
# Leave AZURE_CLIENT_ID empty to disable SSO.
#
# --- Microsoft Graph automatic Teams scheduling (application permissions) ---
# For automatic interview scheduling (no per-user sign-in) set ALL THREE below.
# Create an App Registration in Entra, create a client secret, and grant Admin
# Consent for these APPLICATION permissions:
#   Calendars.ReadWrite.All
#   OnlineMeetings.ReadWrite.All
#   User.Read.All
# Do NOT commit the real secret. Keep it in the gitignored .env only.
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id


